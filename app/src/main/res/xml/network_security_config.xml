<?xml version="1.0" encoding="utf-8"?>
<!--
  Future HTTPS traffic is secure by default. Do not add domain pins until a production endpoint,
  a backup SPKI pin, and a documented key-rotation process have been approved.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
